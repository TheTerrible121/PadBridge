<Window x:Class="PadBridge.Controller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PadBridge" Width="940" Height="650" MinWidth="860" MinHeight="590"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource PageBrush}"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="14" GlassFrameThickness="0"
                            ResizeBorderThickness="7" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="14" Background="{StaticResource PageBrush}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#080808" BorderBrush="#1B1B1B" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/PadBridgeMark.png" Width="31" Height="23" Stretch="Uniform" />
                        <TextBlock Text="PadBridge" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Border Background="#161616" CornerRadius="6" Margin="9,0,0,0" Padding="7,3">
                            <TextBlock Text="1.0" FontSize="10" Foreground="#8E8E8E" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Width="42" Height="36" Padding="0"
                                Content="—" FontSize="16" Click="MinimizeButton_Click" />
                        <Button Style="{StaticResource GhostButton}" Width="42" Height="36" Padding="0"
                                Content="×" FontSize="20" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#1B1B1B"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="30,34,30,28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Image Source="Assets/PadBridgeMark.png" Width="172" Height="116"
                               Stretch="Uniform" HorizontalAlignment="Left" />
                        <StackPanel Grid.Row="1" Margin="0,18,0,0">
                            <TextBlock Text="YOUR SECOND SCREEN" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="Native. Fast. Yours." FontSize="22" FontWeight="SemiBold"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="A true Windows desktop at 120 Hz, with touch and Apple Pencil."
                                       Foreground="#858585" FontSize="13" TextWrapping="Wrap"
                                       LineHeight="20" Margin="0,10,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="3">
                            <TextBlock Text="NORMAL USE" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="Open PadBridge on your iPad, then press Connect. USB is preferred automatically."
                                       Foreground="#707070" FontSize="12" TextWrapping="Wrap"
                                       LineHeight="18" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="42,34,42,34" MaxWidth="620">
                        <TextBlock Text="Extend your Windows desktop" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Plug in, connect, and move your cursor straight onto the iPad."
                                   Foreground="#898989" FontSize="14" Margin="0,7,0,25" />

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="22">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="StatusDot" Width="11" Height="11" Fill="#858585"
                                             VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="StatusTitle" Text="Ready" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock x:Name="StatusDetail" Text="Connect your iPad" Foreground="#858585"
                                                   FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#080808" CornerRadius="9" Padding="11,7">
                                        <TextBlock x:Name="TransportValue" Text="AUTO" Foreground="#B8B8B8"
                                                   FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                                <Border Grid.Row="1" Background="#252525" Margin="0,20,0,17" />
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DISPLAY" Style="{StaticResource LabelStyle}" />
                                        <TextBlock Text="2420 × 1668" FontSize="13" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="REFRESH" Style="{StaticResource LabelStyle}" />
                                        <TextBlock x:Name="RefreshValue" Text="120 Hz adaptive" FontSize="13" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="ENCODER" Style="{StaticResource LabelStyle}" />
                                        <TextBlock Text="NVENC zero-copy" FontSize="13" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButton}"
                                Content="Connect iPad" Margin="0,18,0,0" Click="ConnectButton_Click" />

                        <Expander x:Name="SettingsExpander" Margin="0,24,0,0" Foreground="#D0D0D0">
                            <Expander.Header>
                                <TextBlock Text="Connection &amp; performance" FontSize="13" FontWeight="SemiBold" />
                            </Expander.Header>
                            <Border Background="#0A0A0A" BorderBrush="{StaticResource StrokeBrush}"
                                    BorderThickness="1" CornerRadius="13" Padding="18" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="CONNECTION" Style="{StaticResource LabelStyle}" />
                                        <ComboBox x:Name="ConnectionModeBox" Margin="0,7,0,0" SelectionChanged="ConnectionModeBox_SelectionChanged">
                                            <ComboBoxItem Content="Auto — prefer USB" Tag="Auto" />
                                            <ComboBoxItem Content="USB-C" Tag="Usb" />
                                            <ComboBoxItem Content="Wi-Fi" Tag="Wifi" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="IPAD WI-FI ADDRESS (OPTIONAL)" Style="{StaticResource LabelStyle}" />
                                        <TextBox x:Name="WifiAddressBox" Margin="0,7,0,0" Text="" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Margin="0,15,0,0">
                                        <TextBlock Text="REFRESH RATE" Style="{StaticResource LabelStyle}" />
                                        <ComboBox x:Name="FpsBox" Margin="0,7,0,0">
                                            <ComboBoxItem Content="120 Hz — Ultra" Tag="120" />
                                            <ComboBoxItem Content="60 Hz — Efficient" Tag="60" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,15,0,0">
                                        <TextBlock Text="USB / WI-FI BITRATE" Style="{StaticResource LabelStyle}" />
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBox x:Name="UsbBitrateBox" Text="60" ToolTip="USB Mbps" />
                                            <TextBox x:Name="WifiBitrateBox" Grid.Column="2" Text="35" ToolTip="Wi-Fi Mbps" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,18,0,0">
                                        <CheckBox x:Name="RouteWindowsCheck" Content="Open new apps on the iPad when my cursor is there" />
                                        <CheckBox x:Name="AutoConnectCheck" Content="Connect automatically when PadBridge starts" Margin="0,10,0,0" />
                                        <CheckBox x:Name="StartWithWindowsCheck" Content="Start PadBridge with Windows (system tray)" Margin="0,10,0,0" />
                                        <CheckBox x:Name="CollapseDisplayCheck" Content="Remove the iPad display when disconnected" Margin="0,10,0,0" />
                                    </StackPanel>

                                    <Expander Grid.Row="3" Grid.ColumnSpan="3" Margin="0,18,0,0" Foreground="#A5A5A5">
                                        <Expander.Header><TextBlock Text="Hardware override" FontSize="12" /></Expander.Header>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="DXGI ADAPTER" Style="{StaticResource LabelStyle}" />
                                                <TextBox x:Name="AdapterBox" Text="1" Margin="0,7,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="CAPTURE OUTPUT" Style="{StaticResource LabelStyle}" />
                                                <TextBox x:Name="OutputBox" Text="0" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Expander>

                                    <CheckBox x:Name="ZeroCopyCheck" Grid.Row="4" Grid.ColumnSpan="3"
                                              Content="Keep capture and encoding on the RTX GPU (recommended)"
                                              Margin="0,15,0,0" />
                                </Grid>
                            </Border>
                        </Expander>

                        <Expander x:Name="DiagnosticsExpander" Margin="0,17,0,0" Foreground="#A0A0A0">
                            <Expander.Header><TextBlock Text="Diagnostics" FontSize="12" /></Expander.Header>
                            <TextBox x:Name="LogBox" Height="132" Margin="0,10,0,0" IsReadOnly="True"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
